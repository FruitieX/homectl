{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    "server": {
      "component": "homectl-server",
      "release-type": "rust",
      "extra-files": [
        {
          "type": "toml",
          "path": "/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='homectl-server')].version"
        }
      ]
    },
    "ui": {
      "component": "homectl-ui",
      "release-type": "node"
    }
  }
}
