# homectl monorepo ignore file

# Global tooling/env
.direnv/
.envrc
.moon/cache/
.env*
!.env*.example
.vscode/
.DS_Store
*.pem

# TypeScript build info
*.tsbuildinfo

# Node / frontend
ui/node_modules/
ui/.pnp
ui/.pnp.js
ui/coverage/
ui/.next/
ui/out/
ui/build/
ui/.vercel
ui/.turbo
ui/styles/dist.css
ui/.pnpm-debug.log*
ui/npm-debug.log*
ui/yarn-debug.log*
ui/yarn-error.log*

# Rust / backend
server/target/
server/Settings.toml

# Generated / vendored (if ever used)
server/vendor/

# Generated bindings (Rust -> TS) if produced under server or ui
server/bindings/
ui/bindings/generated/

# Misc
.idea/

# Database / configs
*.db
*.db-shm
*.db-wal
*.toml
*.toml.bak

# Local working plans, reviews, and design mockups
/.hermes/plans/
/docs/settings-mockups/
/docs/*-plan.md
/docs/backend-review.md
/docs/improvement-pass.md
/docs/rule-model-review.md
/docs/settings-ux-inventory.md
/docs/todo.md
/homectl-*-plan.md
/v2.md
